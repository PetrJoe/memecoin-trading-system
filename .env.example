# =============================================================================
# Meme Trader Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER print or log private keys.
# =============================================================================

# Application
APP_ENV=development

# Trading Mode: paper | live_safe | live
TRADING_MODE=paper
TRADING_ENABLED=false

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Jupiter
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Database
DATABASE_URL=postgresql+asyncpg://memetrader:password@localhost:5432/meme_trader

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot Wallet (base58 encoded private key)
# NEVER share this with anyone
BOT_PRIVATE_KEY=

# Risk Limits
MAX_POSITION_USD=0.50
MAX_OPEN_POSITIONS=2
MAX_DAILY_LOSS_USD=1.00
MAX_TOTAL_EXPOSURE_USD=5.00
MAX_SLIPPAGE_BPS=100
MAX_PRICE_IMPACT_BPS=500
MAX_CONSECUTIVE_LOSSES=5
MAX_POSITION_DURATION_HOURS=24

# Strategy Parameters
STOP_LOSS_PERCENT=10
TAKE_PROFIT_PERCENT=25
TRAILING_STOP_PERCENT=15

# Scanner
SCANNER_INTERVAL_SECONDS=20
POSITION_CHECK_INTERVAL_SECONDS=5
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_5M_USD=5000
MIN_RISK_SCORE=70

# Scoring Weights (must sum to 100)
SCORE_WEIGHT_LIQUIDITY=20
SCORE_WEIGHT_VOLUME=20
SCORE_WEIGHT_BUY_PRESSURE=15
SCORE_WEIGHT_MOMENTUM=15
SCORE_WEIGHT_VOLUME_ACCELERATION=10
SCORE_WEIGHT_TOKEN_AGE=10
SCORE_WEIGHT_RISK_SCORE=10
